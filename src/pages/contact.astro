---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
const email = site.contactEmail.trim();
---

<BaseLayout title="Contact" description="How to contact CurioCanine with questions, corrections or feedback.">
  <div class="container page prose">
    <Breadcrumbs items={[{ label: 'Contact' }]} />
    <h1>Contact</h1>
    {email ? (
      <>
        <p class="lede">Questions, corrections or feedback? Send us an email.</p>
        <p><a href={`mailto:${email}`}>{email}</a></p>
        <p class="muted">We cannot give veterinary advice or diagnose behavior problems. For those, please contact a veterinarian or a qualified professional.</p>
      </>
    ) : (
      <p class="lede">Our contact details are being set up. Please check back soon.</p>
    )}
  </div>
</BaseLayout>
