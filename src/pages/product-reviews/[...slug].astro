---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import AffiliateButton from '../../components/AffiliateButton.astro';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', (r) => !r.data.draft);
  return reviews.map((review) => ({ params: { slug: review.id }, props: { review } }));
}

const { review } = Astro.props;
const { Content } = await render(review);
---

<ArticleLayout
  title={review.data.title}
  description={review.data.description}
  pubDate={review.data.pubDate}
  updatedDate={review.data.updatedDate}
  noindex={review.data.noindex}
  isReview={true}
  crumbs={[{ label: 'Product Reviews', href: '/product-reviews/' }, { label: review.data.productName }]}
>
  <Content />
  <AffiliateButton label={`Visit the official ${review.data.productName} site`} />
</ArticleLayout>
