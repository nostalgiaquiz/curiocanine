---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex={true}>
  <div class="container page prose">
    <h1>Page not found</h1>
    <p class="lede">We could not find that page. It may have moved, or the address may be mistyped.</p>
    <div class="btn-row">
      <a class="btn" href="/">Go to the home page</a>
      <a class="btn btn-ghost" href="/guides/">Browse guides</a>
    </div>
  </div>
</BaseLayout>
