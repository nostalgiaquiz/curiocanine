---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, categories } from '../config/site';

// Latest guides: the three newest non-draft articles (same data and ordering as before).
const latest = (await getCollection('articles', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topicBlurbs: Record<string, string> = {
  'dog-training': 'Reward-based training basics, one clear step at a time.',
  'brain-games': 'Simple mental games that give your dog something to think about.',
  'dog-enrichment': 'Ways to make everyday life more interesting for your dog.',
  'puppy-training': 'Gentle starting points for new puppy owners.',
};

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// ---------------------------------------------------------------------------
// Hero photograph
// Add your image as  src/assets/images/hero-dog.jpg  (.jpeg, .png or .webp also work).
// Until the file exists, the page shows a decorative placeholder instead, so the
// site always builds. Edit heroAlt so it describes the photo you actually use.
// ---------------------------------------------------------------------------
const heroModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/hero-dog.{jpg,jpeg,png,webp}',
  { eager: true },
);
const heroImage = Object.values(heroModules)[0]?.default;
const heroAlt =
  'A golden retriever sitting on a sunlit living-room floor with its head tilted, looking attentively at a wooden treat puzzle.';
// Optional small caption under the photo (for example a photo credit). Leave empty for none.
const heroCredit = '';
---

<BaseLayout title={site.name} description={site.description}>
  <!-- ============================== HERO ============================== -->
  <section class="mag-hero" aria-labelledby="hero-title">
    <div class="container mag-hero__grid">
      <div class="mag-hero__copy">
        <p class="mag-kicker">Positive training &middot; Brain games &middot; Enrichment</p>
        <h1 id="hero-title">
          <span class="mag-hero__line">Kind training.</span>
          <span class="mag-hero__line">Clever games.</span>
          <span class="mag-hero__line">A more interesting day for your dog.</span>
        </h1>
        <p class="mag-hero__lede">
          {site.name} shares practical guidance on positive, reward-based dog training, brain games and daily
          enrichment, written for dog owners everywhere. Start with the free planner for a simple weekly routine,
          or explore the topics below.
        </p>
        <div class="btn-row">
          <a class="btn" href="/enrichment-planner/">Build a free enrichment plan</a>
          <a class="btn btn-ghost" href="/guides/">Browse guides</a>
        </div>
        <ul class="mag-trust">
          <li>Positive, reward-based methods</li>
          <li>Free planner, nothing stored</li>
          <li>Affiliate links always disclosed</li>
        </ul>
      </div>

      <figure class="mag-hero__media">
        <div class="mag-hero__frame">
          {heroImage ? (
            <Image
              src={heroImage}
              alt={heroAlt}
              widths={[480, 768, 1100, 1600]}
              sizes="(min-width: 1024px) 540px, 100vw"
              quality={80}
              priority
            />
          ) : (
            <div class="mag-hero__art" aria-hidden="true">
              <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <circle cx="100" cy="100" r="78" style="fill: var(--accent)"></circle>
                <path d="M30 78c34 22 106 22 140 0M30 122c34-22 106-22 140 0" style="fill: none; stroke: var(--bg); stroke-width: 5; stroke-linecap: round"></path>
              </svg>
            </div>
          )}
        </div>
        {heroImage && heroCredit && <figcaption class="mag-hero__credit">{heroCredit}</figcaption>}
      </figure>
    </div>
  </section>

  <!-- ============================== TOPICS ============================== -->
  <section class="container mag-section" aria-labelledby="topics-title">
    <div class="mag-head">
      <div>
        <p class="mag-kicker">The sections</p>
        <h2 id="topics-title">Explore by topic</h2>
      </div>
    </div>
    <ul class="mag-topics">
      {Object.entries(categories).map(([key, c], i) => (
        <li>
          <a class="mag-topic" href={c.href}>
            <span class="mag-topic__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mag-topic__title">{c.label}</h3>
            <span class="mag-topic__text">{topicBlurbs[key]}</span>
            <span class="mag-topic__go" aria-hidden="true">Explore &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ============================== PLANNER ============================== -->
  <section class="container mag-planner-wrap" aria-labelledby="planner-title">
    <div class="mag-planner">
      <div>
        <p class="mag-kicker">Free tool</p>
        <h2 id="planner-title">The Dog Enrichment Planner</h2>
        <p>
          Choose your dog's life stage, energy level, space and time, and get a simple one-week plan of sniffing,
          food, training and calm activities. It runs in your browser, and nothing is stored.
        </p>
      </div>
      <a class="btn" href="/enrichment-planner/">Build my plan</a>
    </div>
  </section>

  <!-- ============================== LATEST GUIDES ============================== -->
  <section class="container mag-section" aria-labelledby="guides-title">
    <div class="mag-head">
      <div>
        <p class="mag-kicker">From the guides</p>
        <h2 id="guides-title">Latest guides</h2>
      </div>
      <a class="mag-link" href="/guides/">All guides</a>
    </div>

    {latest.length > 0 ? (
      <ul class="mag-guides" data-count={latest.length}>
        {latest.map((p, i) => (
          <li class:list={['mag-guide', i === 0 && latest.length > 1 && 'mag-guide--feature']}>
            <p class="mag-guide__meta">
              <span class="mag-guide__cat">{categories[p.data.category].label}</span>
              <span aria-hidden="true"> &middot; </span>
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
            </p>
            <h3><a href={`/guides/${p.id}/`}>{p.data.title}</a></h3>
            <p class="mag-guide__desc">{p.data.description}</p>
            <span class="mag-guide__more" aria-hidden="true">Read the guide &rarr;</span>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mag-empty">
        <p>
          Our first original guides are on the way. Meanwhile, the
          <a href="/enrichment-planner/">Dog Enrichment Planner</a> is ready to use.
        </p>
      </div>
    )}
  </section>

  <!-- ============================== AFFILIATE DISCLOSURE ============================== -->
  <section class="mag-disclosure" aria-labelledby="money-title">
    <div class="container mag-disclosure__inner">
      <span class="mag-disclosure__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 11v5"></path>
          <path d="M12 8h.01"></path>
        </svg>
      </span>
      <div class="prose">
        <h2 id="money-title">Honest about money</h2>
        <p>
          {site.name} is supported by affiliate links, so we may earn a commission if you buy a product through one.
          Our <a href="/product-reviews/">product reviews</a> are labeled, and our
          <a href="/affiliate-disclosure/">Affiliate Disclosure</a> explains how it works.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Shared editorial pieces ---------- */
  .mag-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }
  .mag-kicker::before {
    content: '';
    width: 2rem;
    height: 2px;
    background: var(--accent);
  }
  .mag-section {
    padding-block: var(--section-pad);
  }
  .mag-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-bottom: 2rem;
  }
  .mag-head h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .mag-head .mag-kicker {
    margin-bottom: 0.6rem;
  }
  .mag-link {
    padding-bottom: 0.1rem;
    border-bottom: 2px solid var(--accent);
    font-weight: 700;
    text-decoration: none;
    color: var(--brand);
  }
  .mag-link:hover {
    color: var(--brand-strong);
  }

  /* ---------- Hero ---------- */
  .mag-hero {
    --frame-radius: 1.5rem;
    overflow-x: clip;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    background:
      radial-gradient(60rem 28rem at 88% -10%, var(--surface-alt), transparent 65%),
      var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .mag-hero__grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }
  .mag-hero__copy {
    min-width: 0;
  }
  .mag-hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.35rem, 5.4vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .mag-hero__line {
    display: block;
    text-wrap: balance;
  }
  .mag-hero__lede {
    max-width: 36rem;
    margin: 0 0 2rem;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.6;
    color: var(--text-soft);
  }
  .mag-hero .btn-row {
    gap: 1rem;
  }
  .mag-hero .btn {
    min-height: 3.25rem;
    padding-inline: 1.9rem;
    font-size: 1.05rem;
  }
  .mag-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
    color: var(--text-soft);
  }
  .mag-trust li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
  }
  .mag-trust li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .mag-hero__media {
    position: relative;
    margin: 0;
    min-width: 0;
  }
  /* Offset panel behind the photo gives the frame an editorial, layered look */
  .mag-hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(0.7rem, 0.7rem);
    border: 1px solid var(--line);
    border-radius: var(--frame-radius);
    background: var(--brand-tint);
  }
  .mag-hero__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--frame-radius);
    background: var(--surface-alt);
    box-shadow: var(--shadow);
  }
  .mag-hero__frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }
  .mag-hero__art {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, var(--brand-tint), var(--surface-alt));
  }
  .mag-hero__art svg {
    width: min(55%, 18rem);
    height: auto;
  }
  .mag-hero__credit {
    position: relative;
    margin-top: 1.1rem;
    font-size: 0.8rem;
    text-align: right;
    color: var(--text-soft);
  }

  @media (min-width: 64rem) {
    .mag-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 4rem;
    }
    .mag-hero__frame {
      aspect-ratio: 4 / 5;
    }
    .mag-hero__media::before {
      transform: translate(1rem, 1rem);
    }
  }

  /* ---------- Topic cards ---------- */
  .mag-topics {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mag-topics li {
    margin: 0;
  }
  .mag-topic {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    min-height: 13rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .mag-topic:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .mag-topic__num {
    font-family: var(--font-heading);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--brand);
    opacity: 0.3;
  }
  .mag-topic__title {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--brand);
  }
  .mag-topic__text {
    font-size: 0.98rem;
    color: var(--text-soft);
  }
  .mag-topic__go {
    margin-top: auto;
    padding-top: 0.75rem;
    font-weight: 700;
    color: var(--brand);
  }

  @media (min-width: 36rem) {
    .mag-topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .mag-topics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ---------- Planner feature ---------- */
  .mag-planner-wrap {
    padding-bottom: var(--section-pad);
  }
  .mag-planner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-left: 6px solid var(--accent);
    border-radius: var(--radius);
    background: var(--brand-tint);
  }
  .mag-planner h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 3.4vw, 2.2rem);
  }
  .mag-planner p:not(.mag-kicker) {
    max-width: 44rem;
    margin: 0;
  }
  .mag-planner .btn {
    justify-self: start;
    min-height: 3.25rem;
    padding-inline: 1.9rem;
    font-size: 1.05rem;
  }
  @media (min-width: 48rem) {
    .mag-planner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2.5rem;
    }
  }

  /* ---------- Latest guides ---------- */
  .mag-guides {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mag-guide {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .mag-guide:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
  }
  .mag-guide__meta {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .mag-guide__cat {
    color: var(--brand);
  }
  .mag-guide h3 {
    margin: 0 0 0.6rem;
    font-size: 1.45rem;
    line-height: 1.2;
  }
  /* The title link is stretched over the whole card, so the card is one big click target */
  .mag-guide h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .mag-guide h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .mag-guide h3 a:hover {
    color: var(--brand);
  }
  .mag-guide__desc {
    margin: 0 0 1.25rem;
    color: var(--text-soft);
  }
  .mag-guide__more {
    margin-top: auto;
    font-weight: 700;
    color: var(--brand);
  }
  @supports selector(:has(*)) {
    .mag-guide h3 a:focus-visible {
      outline: none;
    }
    .mag-guide:has(h3 a:focus-visible) {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }
  }

  /* Feature card: the newest guide, in the deep forest tone also used by the footer */
  .mag-guide--feature {
    justify-content: flex-end;
    min-height: 18rem;
    padding: clamp(1.8rem, 4vw, 2.6rem);
    border-color: var(--footer-bg);
    background: var(--footer-bg);
    color: var(--footer-text);
  }
  .mag-guide--feature:hover {
    border-color: var(--footer-bg);
  }
  .mag-guide--feature .mag-guide__meta {
    margin-top: auto;
    color: var(--footer-soft);
  }
  .mag-guide--feature .mag-guide__more {
    margin-top: 1.5rem;
  }
  .mag-guide--feature .mag-guide__cat,
  .mag-guide--feature .mag-guide__more {
    color: var(--footer-focus);
  }
  .mag-guide--feature h3 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
  }
  .mag-guide--feature h3 a,
  .mag-guide--feature h3 a:hover {
    color: var(--footer-text);
  }
  .mag-guide--feature .mag-guide__desc {
    font-size: 1.08rem;
    color: var(--footer-soft);
  }

  .mag-empty {
    max-width: 44rem;
    padding: 1.5rem 1.6rem;
    border: 2px dashed var(--line);
    border-radius: var(--radius);
    background: var(--surface-alt);
  }
  .mag-empty p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .mag-guides[data-count='2'],
    .mag-guides[data-count='3'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mag-guides .mag-guide--feature {
      grid-column: 1 / -1;
    }
    .mag-guides[data-count='1'] {
      max-width: 44rem;
    }
  }
  @media (min-width: 64rem) {
    .mag-guides[data-count='2'],
    .mag-guides[data-count='3'] {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
    .mag-guides .mag-guide--feature {
      grid-column: 1;
    }
    .mag-guides[data-count='3'] .mag-guide--feature {
      grid-row: 1 / span 2;
    }
  }

  /* ---------- Affiliate disclosure ---------- */
  .mag-disclosure {
    padding-block: clamp(2.25rem, 5vw, 3.5rem);
    border-top: 1px solid var(--line);
    background: var(--surface-alt);
  }
  .mag-disclosure__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  .mag-disclosure__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--brand);
  }
  .mag-disclosure h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }
  .mag-disclosure p {
    margin: 0;
  }

  /* ---------- Motion preferences ---------- */
  @media (prefers-reduced-motion: reduce) {
    .mag-topic,
    .mag-guide {
      transition: none;
    }
    .mag-topic:hover,
    .mag-guide:hover {
      transform: none;
    }
  }
</style>
