---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site, categories } from '../config/site';

const latest = (await getCollection('articles', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topicBlurbs: Record<string, string> = {
  'dog-training': 'Reward-based training basics, one clear step at a time.',
  'brain-games': 'Simple mental games that give your dog something to think about.',
  'dog-enrichment': 'Ways to make everyday life more interesting for your dog.',
  'puppy-training': 'Gentle starting points for new puppy owners.',
};
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="container">
      <h1>Give your dog's mind something to do.</h1>
      <p class="lede">
        {site.name} shares positive, reward-based ideas for training, brain games and daily enrichment.
        Start with our free planner and get a simple weekly plan for your dog.
      </p>
      <div class="btn-row">
        <a class="btn" href="/enrichment-planner/">Build a free enrichment plan</a>
        <a class="btn btn-ghost" href="/guides/">Browse guides</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2 style="margin-top:0">Explore by topic</h2>
    <ul class="topic-list">
      {Object.entries(categories).map(([key, c]) => (
        <li><a href={c.href}><strong>{c.label}</strong><span>{topicBlurbs[key]}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2 style="margin-top:0">Latest guides</h2>
      {latest.length > 0 ? (
        <ul class="article-list">
          {latest.map((p) => <ArticleCard title={p.data.title} description={p.data.description} href={`/guides/${p.id}/`} date={p.data.pubDate} />)}
        </ul>
      ) : (
        <p>Our first original guides are on the way. Meanwhile, the <a href="/enrichment-planner/">Dog Enrichment Planner</a> is ready to use.</p>
      )}
    </div>
  </section>

  <section class="section container prose">
    <h2 style="margin-top:0">Honest about money</h2>
    <p>
      {site.name} is supported by affiliate links, so we may earn a commission if you buy a product through one.
      Our <a href="/product-reviews/">product reviews</a> are labeled, and our
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a> explains how it works.
    </p>
  </section>
</BaseLayout>
