---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories } from '../../config/site';

const posts = (await getCollection('articles', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Guides & Articles" description="Original guides on positive dog training, brain games, enrichment and puppy training.">
  <div class="container page">
    <Breadcrumbs items={[{ label: 'Guides & Articles' }]} />
    <h1>Guides &amp; Articles</h1>
    <p class="lede">Original guides on positive training, brain games and enrichment for dogs.</p>
    <p>Browse by topic:
      {Object.values(categories).map((c, i) => <>{i > 0 && ', '}<a href={c.href}>{c.label}</a></>)}.
    </p>

    {posts.length > 0 ? (
      <ul class="article-list">
        {posts.map((p) => <ArticleCard title={p.data.title} description={p.data.description} href={`/guides/${p.id}/`} date={p.data.pubDate} />)}
      </ul>
    ) : (
      <div class="empty">
        <p>No articles have been published yet. We are working on our first original guides.</p>
        <p>You can already use the free <a href="/enrichment-planner/">Dog Enrichment Planner</a>.</p>
      </div>
    )}
  </div>
</BaseLayout>
