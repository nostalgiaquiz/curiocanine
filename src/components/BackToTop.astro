---
// Floating "Back to top" button. Hidden until the page is scrolled about 400px.
// Without JavaScript it stays hidden (and out of the tab order), so there is never a dead button.
---

<div class="back-to-top-sentinel" data-back-to-top-sentinel aria-hidden="true"></div>
<button type="button" class="back-to-top" data-back-to-top aria-label="Back to top">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12 19V5"></path>
    <path d="M5 12l7-7 7 7"></path>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    z-index: 40; /* below the sticky header (50) and the skip link (100) */
    right: calc(1rem + env(safe-area-inset-right, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--brand);
    color: #ffffff;
    box-shadow: var(--shadow);
    cursor: pointer;

    /* Hidden state: invisible, not clickable and not focusable */
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .back-to-top.is-visible:hover {
    background: var(--brand-strong);
    transform: translateY(-2px);
  }

  .back-to-top:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  @media (min-width: 48rem) {
    .back-to-top {
      right: calc(1.5rem + env(safe-area-inset-right, 0px));
      bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  /* In dark mode --brand is a light green, so the arrow switches to the dark page color */
  @media (prefers-color-scheme: dark) {
    .back-to-top {
      color: var(--bg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top,
    .back-to-top.is-visible:hover {
      transition: none;
      transform: none;
    }
  }

  @media print {
    .back-to-top {
      display: none;
    }
  }

  /* Invisible marker the script watches to know when the page is scrolled past 400px */
  .back-to-top-sentinel {
    position: absolute;
    top: 400px;
    left: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const topButton = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const topSentinel = document.querySelector<HTMLElement>('[data-back-to-top-sentinel]');

  if (topButton && topSentinel && 'IntersectionObserver' in window) {
    // Show the button once the marker (400px from the top) has scrolled above the viewport.
    new IntersectionObserver((entries) => {
      const latest = entries[entries.length - 1];
      topButton.classList.toggle('is-visible', !latest.isIntersecting && latest.boundingClientRect.top < 0);
    }).observe(topSentinel);

    topButton.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
      // The button is about to hide, so move keyboard focus to the first link in the header
      // (without scrolling) instead of letting it fall back to the start of the page.
      const firstLink = document.querySelector<HTMLElement>('[data-site-header] a');
      (firstLink ?? document.body).focus({ preventScroll: true });
    });
  }
</script>
