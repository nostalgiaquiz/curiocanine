---
import { site, primaryNav } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/"><span class="brand-dot" aria-hidden="true"></span>{site.name}</a>

    <nav class="nav-wide" aria-label="Main">
      <ul class="nav-list">
        {primaryNav.map((item) => (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <details class="nav-menu">
      <summary>Menu</summary>
      <nav aria-label="Main (mobile)">
        <ul class="nav-list">
          {primaryNav.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
